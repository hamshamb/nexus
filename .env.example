# Nexus backend configuration. Copy to .env (never committed) or export directly.
# All values have sensible defaults; an empty environment runs a working local backend.

# Bind address. Loopback by default; widening this is an explicit decision and
# anything remote is expected to sit behind TLS termination (the client refuses
# remote plaintext http:// anyway).
NEXUS_BACKEND_BIND=127.0.0.1

# HTTP port the coordination service listens on.
NEXUS_BACKEND_PORT=8420

# Which address ranges hosts may register as routes: development (loopback/private
# allowed, for local testing) or production (loopback/link-local refused).
NEXUS_ROUTE_MODE=development

# Comma-separated addresses of reverse proxies whose X-Forwarded-For is believed.
# Empty (default) = the header is ignored entirely.
NEXUS_TRUSTED_PROXIES=

# Session expiry (seconds) when the host stops heartbeating.
NEXUS_SESSION_TTL_SECONDS=90

# How often (seconds) hosts are told to heartbeat.
NEXUS_HEARTBEAT_SECONDS=30

# Rate limiting per remote address: burst capacity and sustained refill.
NEXUS_RATE_CAPACITY=10
NEXUS_RATE_REFILL_PER_SECOND=1

# Client side (the mod): where to find the coordination service.
# Also settable as the JVM property -Dnexus.backend.url.
NEXUS_BACKEND_URL=http://127.0.0.1:8420
